# vhs script for the dashboard tour GIF.
# Rebuild with: vhs assets/dashboard.tape (run from the repository root).
Output assets/dashboard.gif

Set FontSize 14
Set Width 1360
Set Height 560
Set Padding 12
Set Theme "Dracula"

Hide
Type "~/.local/bin/merma"
Enter
Sleep 5s
Show

Sleep 3s
Tab
Sleep 3s
Tab
Sleep 3s
Tab
Sleep 3s
Tab
Sleep 2s

Hide
Type "q"
Sleep 1s
